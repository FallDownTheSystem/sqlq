{
  "name": "@falldownthesystem/sqlq",
  "version": "6.0.1",
  "description": "Read-only Microsoft SQL Server CLI for exploring databases, schemas, and running queries from the terminal",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sqlq": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sql-server",
    "mssql",
    "cli",
    "database",
    "readonly",
    "schema-discovery",
    "data-exploration",
    "query"
  ],
  "author": "FallDownTheSystem",
  "license": "MIT",
  "homepage": "https://github.com/FallDownTheSystem/sqlq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FallDownTheSystem/sqlq.git"
  },
  "bugs": {
    "url": "https://github.com/FallDownTheSystem/sqlq/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "mssql": "^12.7.13",
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
